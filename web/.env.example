# Copy to .env for local development and fill in from Supabase:
# Project Settings -> API.
#
# For GitHub Pages, add these with the same names under repository
# Settings -> Secrets and variables -> Actions -> Repository secrets.
# The anon key is safe to ship to the browser: migration 0006 makes the API
# strictly read-only (RLS with SELECT-only policies).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. The zoning importer falls back to the gis-proxy edge function for
# municipal services that send no CORS headers, and finds it at
# ${VITE_SUPABASE_URL}/functions/v1/gis-proxy on its own — so leave this blank
# unless the proxy is hosted somewhere else.
# VITE_GIS_PROXY_URL=
